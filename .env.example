# Prisma 6 uses provider = "sqlserver" and url = env("DATABASE_URL") in prisma/schema.prisma.
# Replace placeholders in the ignored .env. Never commit real credentials.
# Wrap connection values containing JDBC reserved characters in braces.
# trustServerCertificate=true is only suitable for local development.
DATABASE_URL="sqlserver://localhost:1433;database=RCDRenta;schema=dbo;user=USERNAME;password=PASSWORD;encrypt=true;trustServerCertificate=true"

# Private absolute directory outside the repository and public web root.
PROTOTYPE_UPLOAD_DIR=C:\work\RCD.Rentas.blobs

# Optional private E2E override. Only localhost / RCDRentaE2E is accepted.
# If omitted, scripts derive RCDRentaE2E from the local RCDRenta connection above.
# PROTOTYPE_E2E_DATABASE_URL="sqlserver://localhost:1433;database=RCDRentaE2E;schema=dbo;user=USERNAME;password=PASSWORD;encrypt=true;trustServerCertificate=true"
